{
  // Typecheck do design system. Os componentes são JavaScript com tipos em JSDoc
  // (o site não tem etapa de build), e o TypeScript só verifica — não gera JS.
  // `npm run typecheck` usa este arquivo; `npm run ds:build` emite os .d.ts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "."
  },
  "include": ["components/**/*.js", "patterns/**/*.js", "templates/**/*.js", "showcase/**/*.js"],
  "exclude": ["reference/**", "dist/**"]
}
